# 开发环境端口
VITE_PORT=5889

# Windows 下若用 http://localhost:本端口 访问，浏览器常先连 ::1 再回退到 IPv4，
# DevTools 里会出现「初始连接」约 200～400ms。请优先用：http://127.0.0.1:5889

VITE_BASE=/

# IAM 后端 API 地址（通过 vite proxy 转发）
VITE_GLOB_API_URL=/api

VITE_NITRO_MOCK=false
VITE_DEVTOOLS=true
VITE_INJECT_APP_LOADING=true

# 跳过登录认证（调试用）
VITE_SKIP_AUTH=false

# 强制本地认证，避免开发环境跳转 SSO
VITE_AUTH_MODE=local
