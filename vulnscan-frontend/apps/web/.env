# ===== 通用配置（开发 & 生产共用） =====

# 应用标题（显示在浏览器标签和页头）
VITE_APP_TITLE=全域安全检测平台

# 应用命名空间（缓存、store 前缀，多系统隔离）
VITE_APP_NAMESPACE=vulnscan-web

# Store 加密密钥
VITE_APP_STORE_SECURE_KEY=my-biz-store-key-2026

# API 基础路径（嵌入部署时前后端同域，/api 前缀由后端路由处理）
VITE_GLOB_API_URL=/api

# 登录模式：local = 显示本地登录页，sso = 强制跳转 IAM
# 混合模式下保持 local：直接访问显示登录页，从 IAM 跳转时后端自动处理 SSO
VITE_AUTH_MODE=local

# 跳过登录认证（开发调试用，设为 true 时自动注入 mock token）
VITE_SKIP_AUTH=false
